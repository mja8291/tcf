# --- Auth: pick ONE of the two paths below. OAuth is preferred if both are set. ---

# Path A — OAuth (use this if your Cloud org blocks service-account key creation).
# From an OAuth 2.0 Client ID (Web application type, redirect URI
# https://developers.google.com/oauthplayground) plus a refresh token minted
# via the OAuth Playground with spreadsheets + drive scopes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Path B — Service account JSON key (Editor access on the MQI spreadsheet + Drive photos folder).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full PEM private key. If pasting as a single line, keep the \n escapes —
# the app un-escapes them at read time.
GOOGLE_PRIVATE_KEY=

# Spreadsheet IDs (from the sheet's URL: /spreadsheets/d/<THIS_PART>/edit)
MQI_SPREADSHEET_ID=
SCHOOLS_SPREADSHEET_ID=

# Drive folder to upload survey photos into (root of "MQI Survey Photos").
MQI_PHOTOS_DRIVE_FOLDER_ID=

# Leave the auth vars above unset to fall back to local mock data
# (src/lib/data/mock-schools.ts, src/lib/data/mock-dashboard.ts) so the app
# still runs end to end without any Google access configured.

# Sign-in. Setting AUTH_SECRET (16+ random characters) switches on sign-in:
# people create an account on the Sign up page, an administrator approves it by
# setting Approved to YES on its row in the "Users" tab of MQI_SPREADSHEET_ID
# (the tab is created on the first sign-up), and survey submission, photo
# upload, the dashboard and downloads then require a signed-in, approved user.
# Leave it unset and the app runs with no sign-in at all. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out. On Vercel, set it under Project > Settings >
# Environment Variables (Production) and redeploy.
AUTH_SECRET=
# Optional: name of the tab that holds accounts (default "Users").
USERS_TAB=
